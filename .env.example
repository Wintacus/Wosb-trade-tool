# Copy to .env for local work. NEVER commit a filled-in .env.
# On Vercel these are set in Settings -> Environment Variables (Production + Preview).

# --- Safe for the browser (VITE_ prefix bundles them into client code) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=      # the "Publishable key" (sb_publishable_...) in the current Supabase dashboard

# --- SERVER ONLY. No VITE_ prefix, or they leak into the browser bundle. ---
SUPABASE_SERVICE_ROLE_KEY=   # the "Secret key" (sb_secret_...). Bypasses all row-level security.
ANTHROPIC_API_KEY=           # Phase 3 only. Set a monthly spend limit on it.
DATABASE_URL=                # Supabase -> Settings -> Database -> Connection string (URI).
                             # Used only by /api/migrate to create and seed the schema.
ADMIN_TOKEN=                 # Any long random string. Guards /api/migrate.
