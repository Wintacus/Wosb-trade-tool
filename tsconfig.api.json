{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // nodenext makes TypeScript model REAL Node ESM resolution, which enforces
    // explicit .js extensions on relative imports. Without this the compiler
    // happily accepts `./_sql`, which then fails at runtime with
    // ERR_MODULE_NOT_FOUND and takes the whole function down.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "types": ["node"]
  },
  "include": ["api"]
}
